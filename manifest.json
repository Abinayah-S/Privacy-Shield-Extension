{
  "manifest_version": 3,
  "name": "Privacy Shield",
  "version": "1.3.0",
  "description": "Blocks tracking, advertising, and known malware domains using curated filter lists (EasyList, EasyPrivacy, uBO). Per-list toggles, whitelist, blacklist, statistics.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Privacy Shield",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "core",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "ads_1",
        "enabled": true,
        "path": "rulesets/ads_1.json"
      },
      {
        "id": "ads_2",
        "enabled": true,
        "path": "rulesets/ads_2.json"
      },
      {
        "id": "badware_1",
        "enabled": true,
        "path": "rulesets/badware_1.json"
      },
      {
        "id": "badware_2",
        "enabled": true,
        "path": "rulesets/badware_2.json"
      },
      {
        "id": "badware_3",
        "enabled": true,
        "path": "rulesets/badware_3.json"
      },
      {
        "id": "badware_4",
        "enabled": true,
        "path": "rulesets/badware_4.json"
      },
      {
        "id": "privacy_1",
        "enabled": true,
        "path": "rulesets/privacy_1.json"
      },
      {
        "id": "privacy_2",
        "enabled": true,
        "path": "rulesets/privacy_2.json"
      }
    ]
  }
}